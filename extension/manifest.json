{
  "manifest_version": 3,
  "name": "Apoyos Educativos",
  "version": "0.1.0",
  "description": "Apoyos de accesibilidad para las actividades asignadas: lectura en voz alta, modo lectura, tarea con pasos y glosario con pictogramas.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["vendor/Readability.js", "lectura_calculos.js", "content_script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["teclado_barra.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["media_frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://localhost/*"]
}
